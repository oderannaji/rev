{
  "name": "shepherd-pro-presentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent local scripture and church presentation studio",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "desktop": "npm --prefix desktop start",
    "package:mac": "npm run build && npm --prefix desktop run package:mac",
    "update:staging": "bash scripts/update-local.sh staging"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.149",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "vite": "^7.1.7"
  }
}
